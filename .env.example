# ==============================================================================
# One Store — Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS, SERVICE-ROLE KEYS, OR PERSONAL ACCESS TOKENS.
# Copy this file to .env.local and fill in the values for local development.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & Database)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-only Privileged Key (NEVER expose to client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Payments Configuration (India - INR & UK - GBP)
# ------------------------------------------------------------------------------
# Razorpay (India INR)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your-razorpay-secret-placeholder
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-placeholder

# Stripe (UK GBP & International)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# Transactional Email (Resend / SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM="One Store <orders@yourdomain.com>"
EMAIL_SUPPORT="One Store Support <support@yourdomain.com>"

# ------------------------------------------------------------------------------
# SMS OTP Provider (Optional / When configured for India +91 & UK +44)
# ------------------------------------------------------------------------------
SMS_PROVIDER=none
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# ------------------------------------------------------------------------------
# Analytics & Reporting
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Controlled API key for Power BI reporting layer
REPORTING_API_KEY=your-internal-reporting-api-key-placeholder
